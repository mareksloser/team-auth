{% extends 'security/layout.html.twig' %}

{% block title %}Přihlášení – Klubový účet{% endblock %}

{% block body %}
    <h1>Klubový účet</h1>
    <p class="muted">Jedno přihlášení pro všechny klubové aplikace.</p>

    {% if app.request.query.get('logged_out') %}
        <p class="muted">Byl(a) jsi odhlášen(a).</p>
    {% endif %}

    {% if error %}
        <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="username" required autofocus>

        <label for="password">Heslo</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Přihlásit se</button>
    </form>
{% endblock %}
