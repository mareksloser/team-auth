{% extends 'admin/layout.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
    <h1>{{ title }}: {{ client.name }}</h1>
    <div class="card" style="max-width:640px">
        <p><b>Zkopíruj si secret teď.</b> Ukládá se jen jako hash, znovu ho už nikdo neuvidí.</p>
        <div class="field"><label>client_id</label><div class="secret">{{ client.identifier }}</div></div>
        <div class="field"><label>client_secret</label><div class="secret">{{ secret }}</div></div>
        <p class="hint">Patří do <code>.env.local</code> backendu aplikace, nikdy do frontendu ani do gitu.</p>
        <a class="btn" href="{{ path('admin_client_edit', {identifier: client.identifier}) }}">Hotovo, pokračovat na detail</a>
    </div>
{% endblock %}
