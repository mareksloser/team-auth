{% extends 'admin/layout.html.twig' %}
{% block title %}Uživatelé{% endblock %}
{% block body %}
    <h1>Uživatelé <span class="actions"><a class="btn" href="{{ path('admin_user_new') }}">+ Nový uživatel</a></span></h1>
    <div class="card">
        <form method="get" class="row" style="margin-bottom:1rem">
            <div class="field"><input type="search" name="q" value="{{ q }}" placeholder="Hledat jméno nebo e-mail" aria-label="Hledat"></div>
            <button class="btn secondary" type="submit">Hledat</button>
            {% if q %}<a class="btn secondary" href="{{ path('admin_users') }}">Zrušit</a>{% endif %}
        </form>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Jméno</th><th>E-mail</th><th>Týmy</th><th>Stav</th></tr></thead>
                <tbody>
                {% for u in users %}
                    <tr>
                        <td><a href="{{ path('admin_user_edit', {id: u.id}) }}">{{ u.name }}</a>{% if u.superadmin %} <span class="badge warn">superadmin</span>{% endif %}</td>
                        <td class="mono">{{ u.email }}</td>
                        <td>{% for t in u.teams %}<span class="badge">{{ t.team.slug }} · {{ t.membership.value }}</span> {% endfor %}</td>
                        <td>{% if u.active %}<span class="badge ok">aktivní</span>{% else %}<span class="badge off">deaktivován</span>{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="muted">Nic nenalezeno.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="pager">
            {% if page > 1 %}<a class="btn secondary small" href="{{ path('admin_users', {q: q, page: page - 1}) }}">← Předchozí</a>{% endif %}
            {% if hasNext %}<a class="btn secondary small" href="{{ path('admin_users', {q: q, page: page + 1}) }}">Další →</a>{% endif %}
        </div>
    </div>
{% endblock %}
